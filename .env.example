# ==============================================================================
# AUREX Website — Environment Configuration Guide
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AUTOMATIC EMAIL DELIVERY (Destination: aurexbiotech@gmail.com)
# ------------------------------------------------------------------------------
# Choose either Option A (SMTP / Gmail App Password) or Option B (Resend API)

# OPTION A: SMTP (Gmail or custom SMTP server)
# For Gmail: Generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=aurexbiotech@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM="AUREX Website" <aurexbiotech@gmail.com>

# OPTION B: Resend REST API (https://resend.com)
# RESEND_API_KEY=re_your_api_key_here

# ------------------------------------------------------------------------------
# 2. AUTOMATIC WHATSAPP BUSINESS PLATFORM CLOUD API DELIVERY
# ------------------------------------------------------------------------------
# For automated server-side message dispatch to +91 9543910101
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api

# Meta WhatsApp Cloud API Phone Number ID (from Meta Developer App Dashboard)
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# Meta System User or Permanent Access Token with 'whatsapp_business_messaging' permission
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token

# Target WhatsApp Business Recipient Number (defaults to 919543910101)
WHATSAPP_RECIPIENT_NUMBER=919543910101

# Optional: Pre-approved WhatsApp Template Name and Language
# If omitted, formatted direct text messages are dispatched automatically
# WHATSAPP_TEMPLATE_NAME=aurex_website_enquiry
# WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Optional: Custom Authorized WhatsApp Gateway / Webhook URL
# WHATSAPP_GATEWAY_URL=https://api.yourprovider.com/whatsapp/send

# ------------------------------------------------------------------------------
# 3. DEVELOPMENT / TEST SIMULATION FLAGS (OPTIONAL)
# ------------------------------------------------------------------------------
# Set to 'true' in local dev environments to simulate delivery success without live credentials
CONTACT_SIMULATE_DELIVERY=false

# Test failure modes:
# CONTACT_SIMULATE_FAIL_EMAIL=true
# CONTACT_SIMULATE_FAIL_WHATSAPP=true
