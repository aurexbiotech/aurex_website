# OPTION 1: SMTP Email Delivery (Gmail or any SMTP provider)
# For Gmail: Use an App Password generated at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=aurexbiotech@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM="AUREX Website" <aurexbiotech@gmail.com>

# OPTION 2: Resend API (Alternative to SMTP)
# RESEND_API_KEY=re_your_api_key_here
